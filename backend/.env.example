# ─── App ───────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=changeme-in-production
# Development: http://localhost:3000
# Production : https://scic-indoprima.vercel.app  (URL frontend Vercel kamu)
# Multiple   : https://scic.vercel.app,https://custom-domain.com
CORS_ORIGINS=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# ─── MotherDuck ────────────────────────────────────────────────
MOTHERDUCK_TOKEN=your-motherduck-token
MOTHERDUCK_DB=scic_analytics

# ─── Upstash Redis ─────────────────────────────────────────────
UPSTASH_REDIS_URL=redis://default:password@your-redis.upstash.io:6379
UPSTASH_REDIS_TOKEN=your-redis-token

# ─── ARQ (Background Jobs) ─────────────────────────────────────
# Bisa sama dengan Upstash Redis di atas
ARQ_REDIS_URL=redis://default:password@your-redis.upstash.io:6379

# ─── Pinecone (Cloud Vector DB for RAG) ────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=scic-indoprima
PINECONE_ENVIRONMENT=us-east-1-aws

# ─── Groq (LLM Inference) ──────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── LangSmith (optional — AI tracing & observability) ─────────
# Daftarkan di https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=scic-indoprima

# ─── OpenAI (optional — fallback embedding via langchain-openai) ─
OPENAI_API_KEY=your-openai-api-key
